# Supabase – URL a publishable (dříve "anon") klíč najdeš v `npx supabase status`
# nebo v dashboardu: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Volitelné: veřejná adresa aplikace, která se vkládá do QR kódů (např. https://match.getup.cz).
# Když chybí, vezme se adresa, na které právě běžíš.
NEXT_PUBLIC_SITE_URL=

# Volitelné: push upozornění na nový match (viz README → Push upozornění).
# Klíče vygeneruješ: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt pro push služby (https://… nebo mailto:…)
VAPID_SUBJECT=
# Sdílený klíč s databází (Vault secret push_webhook_secret)
PUSH_WEBHOOK_SECRET=

# Volitelné: COMING_SOON=1 ukáže na úvodní stránce jen upoutávku „Připravujeme“ (bez tlačítka přihlášení;
# tým se přihlásí přímo přes /login). Před spuštěním pro veřejnost proměnnou smaž.
COMING_SOON=
